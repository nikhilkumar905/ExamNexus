{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "credentialsSource": "remote",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.0.246:8000",
        "EXPO_PUBLIC_CONNECTIVITY_URL": "https://www.google.com/favicon.ico"
      }
    },
    "production": {
      "credentialsSource": "remote",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://your-backend.example.com",
        "EXPO_PUBLIC_CONNECTIVITY_URL": "https://www.google.com/favicon.ico"
      }
    }
  }
}
