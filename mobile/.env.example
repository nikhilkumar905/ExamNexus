# Address of the FastAPI backend as seen FROM THE PHONE.
# Use your PC's Wi-Fi IP (run `ipconfig`), not localhost: on a phone, localhost is the phone itself.
EXPO_PUBLIC_API_URL=http://<your-pc-wifi-ip>:8000
# Any small, always-up public URL. Used to check the phone is really offline during an exam.
EXPO_PUBLIC_CONNECTIVITY_URL=https://www.google.com/favicon.ico
