# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=pdf_mcq_exam

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
# If set, registering as a teacher requires this code. Leave empty to allow anyone.
TEACHER_INVITE_CODE=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# RAG
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
# Re-ask the LLM to answer each generated question from the source text and
# drop questions whose answer doesn't match (keeps the answer key consistent).
VERIFY_QUESTIONS=true

# Extra minutes allowed (on top of exam duration) between downloading the paper
# and the answers being uploaded, to cover switching Wi-Fi off/on.
SUBMISSION_GRACE_MINUTES=30
